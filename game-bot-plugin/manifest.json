{
  "manifest_version": 3,
  "name": "Iceman Runner Bot",
  "version": "1.0.0",
  "description": "Auto-plays the Iceman Countdown runner minigame indefinitely",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://www.icemancountdown.com/runner*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Iceman Runner Bot"
  }
}
